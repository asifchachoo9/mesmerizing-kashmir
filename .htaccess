# Mesmerizing Kashmir - cPanel / Apache static deployment
Options -MultiViews
DirectoryIndex public/index.html
RewriteEngine On

# Block Hatchable-only runtime assets when hosted independently.
RewriteRule ^__hatchable(?:/|$) - [R=404,L,NC]

# Never rewrite existing files/directories in the repository root.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_FILENAME} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve the static site from /public while keeping public URLs clean.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]

# Basic browser caching for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# If cPanel has mod_substitute enabled, remove Hatchable bootstrap tags
# from HTML responses without requiring any Hatchable runtime.
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  SubstituteMaxLineLength 2m
  Substitute "s|<script[^>]*src=[\"'][^\"']*/__hatchable/[^\"']*[\"'][^>]*></script>||i"
  Substitute "s|<script>[^<]*__HATCHABLE__[^<]*</script>||i"
</IfModule>
