# Mesmerizing Kashmir - cPanel / Apache deployment
# Point cPanel's document root at the repository root (or public_html).
# The site itself lives in /public.

Options -MultiViews
DirectoryIndex public/index.html

RewriteEngine On

# Never rewrite existing files/directories in the repository root.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_FILENAME} -f [OR]
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Serve the static site from /public while keeping the public URL clean.
RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
RewriteRule ^(.*)$ public/$1 [L]

# Basic browser caching for static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
